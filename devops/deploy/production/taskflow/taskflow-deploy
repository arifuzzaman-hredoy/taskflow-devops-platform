#!/usr/bin/env bash
# /usr/local/bin/taskflow-deploy
# Deploys immutable GHCR images (backend + frontend) for the split TaskFlow stack.
# Usage: sudo taskflow-deploy sha-<40-character commit SHA>
set -Eeuo pipefail
umask 077

APP_DIR="${TASKFLOW_APP_DIR:-/opt/taskflow}"
COMPOSE_FILE="$APP_DIR/compose.yaml"

BACKEND_SERVICE="backend"
FRONTEND_SERVICE="frontend"
NGINX_SERVICE="nginx"
BACKEND_CONTAINER="taskflow-backend-1"
FRONTEND_CONTAINER="taskflow-frontend-1"
NGINX_CONTAINER="taskflow-nginx-1"

BACKEND_REPO="ghcr.io/arifuzzaman-hredoy/taskflow-backend"
FRONTEND_REPO="ghcr.io/arifuzzaman-hredoy/taskflow-frontend"

HEALTH_URL="https://taskflow.oxytumzone.com/api/ready"
HEALTH_ATTEMPTS=24
ROLLBACK_ATTEMPTS=24
RETRY_SECONDS=5
TMP_DIR=""

cleanup() {
    local exit_status=$?
    trap - EXIT
    if [[ -n "$TMP_DIR" ]]; then
        rm -rf -- "$TMP_DIR" >/dev/null 2>&1 || true
    fi
    exit "$exit_status"
}
trap cleanup EXIT

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: Run this script with sudo." >&2
    exit 2
fi

if [[ $# -ne 1 ]]; then
    echo "Usage: sudo taskflow-deploy sha-<40-character commit SHA>" >&2
    exit 2
fi

TAG="$1"
if [[ ! "$TAG" =~ ^sha-[0-9a-f]{40}$ ]]; then
    echo "ERROR: Image tag must be sha-<40-character lowercase commit SHA>." >&2
    exit 2
fi

# Only one deployment at a time.
exec 9>/var/lock/taskflow-deploy.lock
if ! flock -n 9; then
    echo "ERROR: Another deployment is already running." >&2
    exit 1
fi

NEW_BACKEND_IMAGE="${BACKEND_REPO}:${TAG}"
NEW_FRONTEND_IMAGE="${FRONTEND_REPO}:${TAG}"
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/taskflow-deploy.XXXXXXXX")"
chmod 700 "$TMP_DIR"
PUBLIC_RESPONSE="$TMP_DIR/public-readiness.json"

compose() {
    docker compose --project-directory "$APP_DIR" -f "$COMPOSE_FILE" "$@"
}

health_json_is_ready() {
    grep -Eq '"status"[[:space:]]*:[[:space:]]*"ready"' "$1" &&
        grep -Eq '"database"[[:space:]]*:[[:space:]]*"ok"' "$1"
}

# running AND docker healthcheck says healthy
container_healthy() {
    local state
    state="$(docker inspect \
        --format '{{.State.Running}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
        "$1" 2>/dev/null)" || return 1
    [[ "$state" == "true healthy" ]]
}

container_image_id() {
    docker inspect --format '{{.Image}}' "$1" 2>/dev/null
}

container_image_matches() {
    local actual
    actual="$(container_image_id "$1")" || return 1
    [[ "$actual" == "$2" ]]
}

internal_readiness() {
    docker exec "$BACKEND_CONTAINER" node -e '
fetch("http://127.0.0.1:3001/api/ready", { signal: AbortSignal.timeout(3000) })
  .then(async response => {
    const payload = await response.json();
    if (!response.ok || payload.status !== "ready" || payload.database !== "ok") process.exit(1);
  })
  .catch(() => process.exit(1));
' >/dev/null 2>&1
}

public_readiness() {
    local http_status
    http_status="$(
        curl --connect-timeout 5 --max-time 10 --silent --show-error \
            --output "$PUBLIC_RESPONSE" --write-out '%{http_code}' "$HEALTH_URL" \
            2>/dev/null
    )" || return 1
    [[ "$http_status" == "200" ]] && health_json_is_ready "$PUBLIC_RESPONSE"
}

# Print a repo@sha256:<digest> reference for an image ID, if one exists.
digest_ref_of() {
    local image_id="$1" repo="$2" ref hash
    while IFS= read -r ref; do
        if [[ "$ref" == "$repo@sha256:"* ]]; then
            hash="${ref#"$repo"@sha256:}"
            if [[ "$hash" =~ ^[0-9a-f]{64}$ ]]; then
                printf '%s\n' "$ref"
                return 0
            fi
        fi
    done < <(docker image inspect "$image_id" \
        --format '{{range .RepoDigests}}{{println .}}{{end}}' 2>/dev/null)
    return 1
}

# Update backend + frontend to the given images, then recreate nginx so it
# re-resolves the new container addresses. The images are passed through the
# environment, so .env is never modified.
apply_images() {
    export TASKFLOW_BACKEND_IMAGE="$1"
    export TASKFLOW_FRONTEND_IMAGE="$2"
    compose up -d --no-deps "$BACKEND_SERVICE" "$FRONTEND_SERVICE" >/dev/null 2>&1 &&
        compose up -d --no-deps --force-recreate "$NGINX_SERVICE" >/dev/null 2>&1 &&
        docker exec "$NGINX_CONTAINER" nginx -t >/dev/null 2>&1
}

verify_images() {
    local backend_id="$1" frontend_id="$2"
    container_healthy "$BACKEND_CONTAINER" &&
        container_image_matches "$BACKEND_CONTAINER" "$backend_id" &&
        container_healthy "$FRONTEND_CONTAINER" &&
        container_image_matches "$FRONTEND_CONTAINER" "$frontend_id" &&
        internal_readiness &&
        public_readiness
}

rollback() {
    local attempt rollback_verified=0 command_ok=1

    echo "Deployment failed; attempting rollback to the previous images."
    if ! apply_images "$OLD_BACKEND_REF" "$OLD_FRONTEND_REF"; then
        command_ok=0
    fi

    for ((attempt = 1; attempt <= ROLLBACK_ATTEMPTS; attempt++)); do
        if verify_images "$OLD_BACKEND_ID" "$OLD_FRONTEND_ID"; then
            rollback_verified=1
            break
        fi
        sleep "$RETRY_SECONDS"
    done

    if [[ "$command_ok" -eq 1 && "$rollback_verified" -eq 1 ]]; then
        echo "Deployment failed; rollback succeeded and was verified."
    else
        echo "CRITICAL: Deployment failed and rollback verification failed."
    fi
    return 1
}

fail_and_rollback() {
    echo "ERROR: $1" >&2
    rollback || true
    exit 1
}

# ---------- Preflight: capture the currently running state ----------

for container in "$BACKEND_CONTAINER" "$FRONTEND_CONTAINER"; do
    if ! container_healthy "$container"; then
        echo "ERROR: $container is not running and healthy; refusing deployment." >&2
        exit 1
    fi
done

OLD_BACKEND_ID="$(container_image_id "$BACKEND_CONTAINER")" || {
    echo "ERROR: Could not capture the current backend image identity." >&2
    exit 1
}
OLD_FRONTEND_ID="$(container_image_id "$FRONTEND_CONTAINER")" || {
    echo "ERROR: Could not capture the current frontend image identity." >&2
    exit 1
}
for image_id in "$OLD_BACKEND_ID" "$OLD_FRONTEND_ID"; do
    if [[ ! "$image_id" =~ ^sha256:[0-9a-f]{64}$ ]]; then
        echo "ERROR: A current image identity is invalid; refusing deployment." >&2
        exit 1
    fi
done

OLD_BACKEND_REF="$(digest_ref_of "$OLD_BACKEND_ID" "$BACKEND_REPO")" || {
    echo "ERROR: No valid previous backend image digest; refusing deployment." >&2
    exit 1
}
OLD_FRONTEND_REF="$(digest_ref_of "$OLD_FRONTEND_ID" "$FRONTEND_REPO")" || {
    echo "ERROR: No valid previous frontend image digest; refusing deployment." >&2
    exit 1
}

# The digest references must resolve to exactly the images that are running.
[[ "$(docker image inspect "$OLD_BACKEND_REF" --format '{{.Id}}' 2>/dev/null)" == "$OLD_BACKEND_ID" ]] || {
    echo "ERROR: Previous backend digest does not match the running image; refusing deployment." >&2
    exit 1
}
[[ "$(docker image inspect "$OLD_FRONTEND_REF" --format '{{.Id}}' 2>/dev/null)" == "$OLD_FRONTEND_ID" ]] || {
    echo "ERROR: Previous frontend digest does not match the running image; refusing deployment." >&2
    exit 1
}

echo "========== TASKFLOW DEPLOYMENT =========="
echo "Requested backend image:  $NEW_BACKEND_IMAGE"
echo "Requested frontend image: $NEW_FRONTEND_IMAGE"
echo "Previous image identities captured for rollback."

# ---------- Pull (nothing running is touched if this fails) ----------

if ! docker pull "$NEW_BACKEND_IMAGE" >/dev/null 2>&1; then
    echo "ERROR: Could not pull $NEW_BACKEND_IMAGE. Nothing was changed." >&2
    exit 1
fi
if ! docker pull "$NEW_FRONTEND_IMAGE" >/dev/null 2>&1; then
    echo "ERROR: Could not pull $NEW_FRONTEND_IMAGE. Nothing was changed." >&2
    exit 1
fi

NEW_BACKEND_ID="$(docker image inspect "$NEW_BACKEND_IMAGE" --format '{{.Id}}' 2>/dev/null)" || {
    echo "ERROR: Could not verify the pulled backend image. Nothing was changed." >&2
    exit 1
}
NEW_FRONTEND_ID="$(docker image inspect "$NEW_FRONTEND_IMAGE" --format '{{.Id}}' 2>/dev/null)" || {
    echo "ERROR: Could not verify the pulled frontend image. Nothing was changed." >&2
    exit 1
}
for image_id in "$NEW_BACKEND_ID" "$NEW_FRONTEND_ID"; do
    if [[ ! "$image_id" =~ ^sha256:[0-9a-f]{64}$ ]]; then
        echo "ERROR: A pulled image identity is invalid. Nothing was changed." >&2
        exit 1
    fi
done

# ---------- Deploy ----------

if ! apply_images "$NEW_BACKEND_IMAGE" "$NEW_FRONTEND_IMAGE"; then
    fail_and_rollback "Compose could not update the backend/frontend services."
fi

healthy=0
for ((attempt = 1; attempt <= HEALTH_ATTEMPTS; attempt++)); do
    if verify_images "$NEW_BACKEND_ID" "$NEW_FRONTEND_ID"; then
        healthy=1
        break
    fi
    sleep "$RETRY_SECONDS"
done

if [[ "$healthy" -ne 1 ]]; then
    fail_and_rollback "The new images did not pass identity and readiness checks."
fi

echo "SUCCESS: TaskFlow deployment is healthy."
echo "Deployed backend:  $NEW_BACKEND_IMAGE"
echo "Deployed frontend: $NEW_FRONTEND_IMAGE"
